# Copia este archivo a .env.local y coloca los valores reales de TU proyecto de Supabase.
# Los encuentras en: Supabase Dashboard → tu proyecto → Project Settings → API.
#
# VITE_SUPABASE_ANON_KEY es la llave pública ("anon"). Está diseñada para vivir en el
# navegador del usuario (queda dentro del JS compilado) — eso es normal y seguro SIEMPRE
# que Row Level Security (RLS) esté activo en todas las tablas (ver supabase/schema.sql).
#
# NUNCA copies aquí la "service_role key". Esa llave se salta RLS por completo y jamás
# debe usarse en código de cliente/navegador. Este proyecto no la necesita.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-PUBLIC-KEY
